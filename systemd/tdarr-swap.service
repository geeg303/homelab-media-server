[Unit]
Description=Replace library originals with verified Tdarr encodes (4K + 1080p; originals deleted after verification)
RequiresMountsFor=/mnt/disk1 /scratch
[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/local/sbin/tdarr-swap /scratch/tdarr/output-4k
ExecStart=/usr/local/sbin/tdarr-swap /scratch/tdarr/output-1080p
